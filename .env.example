# MindCare AI - Environment Variables Configuration

# LLM Providers ("gemini" | "openai" | "offline")
LLM_PROVIDER=gemini
LLM_MODEL=gemini-1.5-flash
GEMINI_API_KEY=
OPENAI_API_KEY=

# Database: SQLite by default (Zero configuration, runs out-of-the-box)
DATABASE_URL=sqlite:///./mindcare.db
# Optional PostgreSQL (for production/cloud deployment):
# DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/mindcare

# Vector Database (Embedded local Qdrant or remote Qdrant Cloud)
VECTOR_DATABASE_URL=
VECTOR_STORAGE_PATH=./qdrant_storage
VECTOR_COLLECTION=mental_health_knowledge

# Security & Authentication
JWT_SECRET=super-secret-mindcare-key-change-in-production-2024-jwt
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Embedding & RAG Parameters
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CHUNK_SIZE=500
CHUNK_OVERLAP=100
TOP_K=5
SIMILARITY_THRESHOLD=0.25

# Frontend
FRONTEND_URL=http://localhost:5173
